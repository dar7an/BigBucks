# Copy to .env and fill in values. Never commit .env.

# Required in any networked deployment. The default is only for local flask run.
SECRET_KEY=change-me-to-a-long-random-string

# fixture  — seeded HistoricPriceData, no network (default; clone-and-run)
# alphavantage — live TIME_SERIES_DAILY (free). Set ALPHA_VANTAGE_API_KEY.
MARKET_DATA_SOURCE=fixture
ALPHA_VANTAGE_API_KEY=

# Annual risk-free rate as a decimal. Used for Sharpe.
# Default 0.043 approximates a 4.3% 10-year Treasury yield.
RISK_FREE_RATE=0.043

# Virtual cash credited on registration.
STARTING_CASH=1000000

# Seed alice / admin demo accounts on flask --app bigbucks init-db (local teaching).
SEED_DEMO_USERS=1
